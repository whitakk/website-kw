---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const pages = await getCollection("pages");
const aboutPage = pages.find((page) => page.slug === "about");

if (!aboutPage) {
  throw new Error("Expected src/content/pages/about.md to exist");
}

const { Content } = await aboutPage.render();
---

<BaseLayout
  title={aboutPage.data.title}
  description={aboutPage.data.description}
  image={aboutPage.data.image}
>
  {aboutPage.data.showTitle && <h1>{aboutPage.data.title}</h1>}
  <Content />
</BaseLayout>
